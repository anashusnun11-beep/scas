# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string
# Local:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/scas_db
# Neon:   postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
DATABASE_URL=""

# Auth.js secret. Generate one with:  npx auth secret
AUTH_SECRET=""

